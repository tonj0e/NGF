'use client'
import { useEffect, useState } from 'react'
import * as React from 'react'
import { Session } from '@/types'
import { currency } from '@/lib/utils'

function currency(n: number) {
  return new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n)
}

function AreaChart({ data }: { data: Record<string, number> }) {
  const entries = Object.entries(data).sort(([a], [b]) => a.localeCompare(b)).slice(-14)
  if (!entries.length) return <p className="py-12 text-center text-xs text-textSecondary">No collections this period.</p>
  const vals = entries.map(([, v]) => v)
  const max = Math.max(...vals, 1)
  // Use relative dimensions for responsiveness
  const W = 640, H = 220, PAD = 34
  const innerW = W - PAD * 2, innerH = H - PAD * 2
  const n = entries.length
  const x = (i: number) => PAD + (n === 1 ? innerW / 2 : (i / (n - 1)) * innerW)
  const y = (v: number) => PAD + innerH - (v / max) * innerH
  const pts = entries.map(([, v], i) => [x(i), y(v)] as const)
  // smooth Catmull-Rom → cubic bezier
  const line = (() => {
    if (n < 2) return `M${pts[0][0]} ${pts[0][1]}`
    let d = `M${pts[0][0]} ${pts[0][1]}`
    for (let i = 0; i < n - 1; i++) {
      const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2
      const c1x = p1[0] + (p2[0] - p0[0]) / 6, c1y = p1[1] + (p2[1] - p0[1]) / 6
      const c2x = p2[0] - (p3[0] - p1[0]) / 6, c2y = p2[1] - (p3[1] - p1[1]) / 6
      d += ` C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2[0]} ${p2[1]}`
    }
    return d
  })()
  const area = `${line} L ${pts[n - 1][0]} ${PAD + innerH} L ${pts[0][0]} ${PAD + innerH} Z`
  const grid = [0, 0.25, 0.5, 0.75, 1]
  const labelStep = Math.max(1, Math.ceil(n / 7))
  return (
    <div className="w-full" style={{ maxWidth: '100%' }}>
      <svg viewBox={`0 0 ${W} ${H}`} className="w-full" style={{ height: 'auto', maxHeight: 240, width: '100%' }} preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stopColor="#" + "1"" stopOpacity="0.28" />
          <stop offset="100%" stopColor="#" + "1"" stopOpacity="0" />
        </linearGradient>
        <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stopColor="#" + "1"" />
          <stop offset="100%" stopColor="#" + "1"" />
        </linearGradient>
      </defs>
      {grid.map(g => {
        const yy = PAD + innerH - g * innerH
        return (
          <g key={g}>
            <line x1={PAD} y1={yy} x2={W - PAD} y2={yy} stroke="#" + "1" + "1" + "1" strokeWidth="1" />
            <text x={PAD - 8} y={yy + 3} fontSize="9" fill="#" + "1" + "1" + "1" textAnchor="end">
              {max * g >= 1000 ? `${Math.round(max * g / 1000)}k` : Math.round(max * g)}
            </text>
          </g>
        )
      })}
      <path d={area} fill="url(#areaGrad)" />
      <path d={line} fill="none" stroke="url(#lineGrad)" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" />
      {pts.map((p, i) => entries[i][1] > 0 && (
        <g key={i}>
          <circle cx={p[0]} cy={p[1]} r="5" fill="#" + "1" + "1" + "1" stroke="#" + "1" + "1" + "1" strokeWidth="2.5" />
          <title>{`${entries[i][0]}: ${currency(entries[i][1])}`}</title>
        </g>
      ))}
      {entries.map(([d], i) => (i % labelStep === 0 || i === n - 1) && (
        <text key={d} x={x(i)} y={H - 10} fontSize="9.5" fill="#" + "1" + "1" + "1" textAnchor="middle">{d.slice(5)}</text>
      ))}
    </svg>
  </div>
  )
}

function Donut({ segments, centerValue, centerLabel }: {
  segments: { label: string; value: number; color: string }[]
  centerValue: string | number; centerLabel: string
}) {
  const total = segments.reduce((s, x) => s + x.value, 0)
  const R = 54, C = 2 * Math.PI * R, sw = 18
  let offset = 0
  return (
    <div className="flex items-center gap-4 md:gap-5">
      <svg viewBox="0 0 140 140" className="h-32 md:h-36 w-32 md:w-36 shrink-0" preserveAspectRatio="xMidYMid meet">
        <g transform="rotate(-90 70 70)">
          <circle cx="70" cy="70" r={R} fill="none" stroke="#" + "1" + "1" + "1" strokeWidth={sw} />
          {total > 0 && segments.map((s, i) => {
            const len = (s.value / total) * C
            const el = (
              <circle key={i} cx="70" cy="70" r={R} fill="none" stroke={s.color} strokeWidth={sw}
                strokeDasharray={`${len} ${C - len}`} strokeDashoffset={-offset} />
            )
            offset += len
            return el
          })}
        </g>
        <text x="70" y="66" textAnchor="middle" fontSize="24" fontWeight="700" fill="#" + "1" + "1" + "1">{centerValue}</text>
        <text x="70" y="86" textAnchor="middle" fontSize="10" fill="#" + "1" + "1" + "1">{centerLabel}</text>
      </svg>
      <div className="flex-1 min-w-0 space-y-2 md:space-y-2.5">
        {segments.map(s => (
          <div key={s.label} className="flex items-center gap-2 text-xs md:text-sm">
            <span className="h-2.5 w-2.5 rounded-full shrink-0" style={{ background: s.color }} />
            <span className="text-textSecondary truncate">{s.label}</span>
            <span className="ml-auto font-semibold">{s.value}</span>
          </div>
        ))}
      </div>
    </div>
  )
}

function Gauge({ value }: { value: number }) {
  const segs = 22
  const filled = Math.round((Math.max(0, Math.min(100, value)) / 100) * segs)
  const cx = 110, cy = 110, rIn = 56, rOut = 82
  const startAng = 210, endAng = -30 // sweep 240°, opens at bottom
  const ticks = Array.from({ length: segs }, (_, i) => {
    const t = i / (segs - 1)
    const ang = (startAng + (endAng - startAng) * t) * Math.PI / 180
    return {
      x1: cx + rIn * Math.cos(ang), y1: cy - rIn * Math.sin(ang),
      x2: cx + rOut * Math.cos(ang), y2: cy - rOut * Math.sin(ang),
      on: i < filled,
    }
  })
  return (
    <svg viewBox="0 0 220 180" className="w-full max-w-xs" preserveAspectRatio="xMidYMid meet">
      {ticks.map((tk, i) => (
        <line key={i} x1={tk.x1} y1={tk.y1} x2={tk.x2} y2={tk.y2}
          stroke={tk.on ? '#4d7c2f' : '#e5e7eb'} strokeWidth="7" strokeLinecap="round" />
      ))}
      <text x={cx} y={cy + 2} textAnchor="middle" fontSize="34" fontWeight="700" fill="#" + "1" + "1" + "1">{value}%</text>
    </svg>
  )
}

export default function Dashboard({ session }: { session: Session }) {
  const [data, setData] = useState<any>(null)
  const [loading, setLoading] = useState(true)
  const [proj, setProj] = useState<any>(null)

  useEffect(() => {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), 15000)
    fetch('/api/dashboard', { headers: { Authorization: `Bearer ${session.token}` }, signal: ctrl.signal })
      .then(r => r.json()).then(r => { if (r.success) setData(r.data) })
      .catch(() => {})
      .finally(() => { clearTimeout(timer); setLoading(false) })
    if (session.role === 'Admin') {
      fetch('/api/projection', { headers: { Authorization: `Bearer ${session.token}` } })
        .then(r => r.json()).then(r => { if (r.success) setProj(r.data) }).catch(() => {})
    }
  }, [session.token, session.role])

  if (loading) return <div className="flex h-40 items-center justify-center"><div className="h-6 w-6 animate-spin rounded-full border-2 border-textPrimary border-t-transparent" /></div>
  if (!data) return <p className="text-sm text-textSecondary">Failed to load dashboard.</p>

  const m = data.metrics
  const isAdmin = session.role === 'Admin'
  const isGuarantor = session.role === 'Guarantor'

  const adminMetrics = [
    { label: 'Total Loan Amount', value: currency(m.totalLoanAmount || 0), sub: `${m.activeLoans} loan${m.activeLoans !== 1 ? 's' : ''} in portfolio` },
    { label: 'This Week Collection', value: currency(m.thisWeekCollection || 0), sub: 'Due this coming Saturday' },
    { label: 'Active Loans', value: m.activeLoans, sub: `${m.overdueLoans} overdue repayments` },
    { label: 'Completed Loans', value: m.completedLoans, sub: `${m.renewalEligible} renewal eligible` },
    { label: 'Pending Leads', value: m.pendingLeads, sub: `${m.activeCustomers} active customers` },
  ]

  const guarantorMetrics = [
    { label: 'My Active Loans', value: m.activeLoans, sub: `${m.overdueLoans} overdue` },
    { label: 'My Pending Leads', value: m.pendingLeads, sub: 'Awaiting approval' },
    { label: 'Commission Earned', value: currency(m.commissionEarned || 0), sub: 'Total to date' },
  ]

  const agentMetrics = [
    { label: 'Assigned Verifications', value: m.assignedVerifications || 0, sub: 'Pending field visit' },
    { label: "Today's Collections", value: m.todayDue || 0, sub: 'Due today' },
    { label: 'Collected This Week', value: currency(m.weekCollected || 0), sub: 'This week' },
  ]

  const metrics = isAdmin ? adminMetrics : isGuarantor ? guarantorMetrics : agentMetrics

  const monthCollected = Object.values(data.weeklyCollections as Record<string, number>).reduce((s, v) => s + v, 0)

  return (
    <div className="space-y-5">
{/* Capital (Admin) */}
      {isAdmin && (
        <div className="rounded-[1.75rem] border border-white/70 bg-white p-4 md:p-5 shadow-panel">
          <p className="text-sm font-semibold mb-4">Capital</p>
          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            <div className="rounded-2xl bg-primary-50 px-3 md:px-4 py-3 md:py-4">
              <p className="text-xs text-textSecondary">Total Capital</p>
              <p className="mt-1 text-xl md:text-2xl font-bold">{currency(data.metrics.totalCapital || 0)}</p>
            </div>
            <div className="rounded-2xl bg-primary-50 px-3 md:px-4 py-3 md:py-4">
              <p className="text-xs text-textSecondary">Available Capital</p>
              <p className={`mt-1 text-xl md:text-2xl font-bold ${(data.metrics.availableCapital || 0) < 0 ? 'text-red-600' : 'text-green-700'}`}>
                {currency(data.metrics.availableCapital || 0)}
              </p>
            </div>
            <div className="rounded-2xl bg-primary-50 px-3 md:px-4 py-3 md:py-4">
              <p className="text-xs text-textSecondary">Interest</p>
              <p className="mt-1 text-xl md:text-2xl font-bold text-amber-600">{currency(data.metrics.totalInterest || 0)}</p>
            </div>
            <div className="rounded-2xl bg-primary-50 px-3 md:px-4 py-3 md:py-4">
              <p className="text-xs text-textSecondary">Investor Money</p>
              <p className="mt-1 text-xl md:text-2xl font-bold">{currency(data.metrics.investorMoney || 0)}</p>
            </div>
          </div>
        </div>
      )}

      {/* Projected Returns (Admin) */}
      {isAdmin && proj && (
        <div className="rounded-[1.75rem] border border-white/70 bg-white p-4 md:p-5 shadow-panel">
          <div className="flex flex-col md:flex-row items-start md:items-center justify-between flex-wrap gap-3 mb-4">
            <div>
              <p className="text-sm font-semibold">Projected Returns</p>
              <p className="text-xs text-textSecondary">Compounding · re-lend all collections · on {currency(proj.inputs.capital)} available</p>
            </div>
            <div className="text-right text-left md:text-right">
              <p className="text-2xl md:text-3xl font-bold text-green-700">{proj.yearReturnPct}%<span className="text-sm font-medium text-textSecondary"> / year</span></p>
              <p className="text-xs text-textSecondary">{proj.totalLoans} loans · {currency(proj.totalProfit)} profit in 52 wks</p>
            </div>
          </div>
          <div className="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-5">
            {proj.periods.map((p: any) => (
              <div key={p.label} className="rounded-2xl bg-primary-50 px-2 md:px-3 py-2 md:py-3 text-center">
                <p className="text-[10px] md:text-[11px] text-textSecondary">{p.label}</p>
                <p className="mt-0.5 text-base md:text-lg font-bold text-green-700">{p.returnPct}%</p>
                <p className="text-[9px] md:text-[10px] text-textSecondary">{currency(p.profit)}</p>
              </div>
            ))}
          </div>
          <p className="mt-3 text-[10px] md:text-[11px] text-textSecondary">Assumes full borrower demand & on-time collection — real returns lower with idle cash or defaults.</p>
        </div>
      )}

      {/* Metric cards */}
      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5">
        {metrics.map(m => (
          <div key={m.label} className="rounded-[1.5rem] border border-white/70 bg-white p-4 md:p-5 shadow-panel">
            <p className="text-xs text-textSecondary">{m.label}</p>
            <p className="mt-1 md:mt-2 text-2xl md:text-3xl font-semibold">{m.value}</p>
            <p className="mt-1 text-xs text-textSecondary">{m.sub}</p>
          </div>
        ))}
      </div>

      <div className="grid gap-4 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        {/* Weekly Collection Trend */}
        <div className={`${isAdmin ? 'lg:col-span-2' : ''} rounded-[1.75rem] border border-white/70 bg-white p-5 shadow-panel`}>
          <div className="flex items-start justify-between mb-4">
            <div>
              <p className="text-sm font-semibold">Collection Trend</p>
              <p className="text-xs text-textSecondary">Paid collections by day</p>
            </div>
            <span className="rounded-2xl bg-gradient-to-r from-indigo-50 to-purple-50 px-3 py-1 text-xs font-semibold text-indigo-700">Month collected {currency(monthCollected)}</span>
          </div>
          <AreaChart data={data.weeklyCollections} />
        </div>

        {/* Right column (Admin): portfolio + recollection rate */}
        {isAdmin && (
          <div className="space-y-5">
            <div className="rounded-[1.75rem] border border-white/70 bg-white p-5 shadow-panel">
              <p className="text-sm font-semibold mb-1">Loan Portfolio</p>
              <p className="text-xs text-textSecondary mb-4">Active vs completed</p>
              <Donut
                centerValue={(m.activeLoans || 0) + (m.completedLoans || 0)}
                centerLabel="loans"
                segments={[
                  { label: 'On-track', value: Math.max(0, (m.activeLoans || 0) - (m.overdueLoans || 0)), color: '#' + '22c55e' as const },
                  { label: 'Overdue', value: m.overdueLoans || 0, color: '#' + 'ef4444' as const },
                  { label: 'Completed', value: m.completedLoans || 0, color: '#' + '6366f1' as const },
                ]}
              />
            </div>

            <div className="rounded-[1.75rem] border border-white/70 bg-white p-5 shadow-panel">
              <p className="text-sm font-semibold">Recollection Rate</p>
              <p className="text-xs text-textSecondary">Collected vs due so far</p>
              <Gauge value={m.recollectionRate ?? 0} />
              <p className="-mt-2 text-center text-xs text-textSecondary">
                {(m.recollectionRate ?? 0) >= 90 ? 'Excellent recovery — keep it up' : (m.recollectionRate ?? 0) >= 70 ? 'Good, some dues pending' : 'Recovery needs attention'}
              </p>
              <div className="mt-4 grid grid-cols-2 gap-3 border-t border-black/5 pt-4 text-center">
                <div>
                  <p className="text-xs text-textSecondary">Collected</p>
                  <p className="text-lg font-bold text-green-700">{m.collectedCount ?? 0}</p>
                </div>
                <div>
                  <p className="text-xs text-textSecondary">Pending</p>
                  <p className="text-lg font-bold text-red-600">{m.pendingCount ?? 0}</p>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {[
              { label: 'Active Customers', value: data.metrics.activeCustomers },
              { label: 'Pending Leads', value: data.metrics.pendingLeads },
              { label: 'Overdue Loans', value: data.metrics.overdueLoans },
              { label: 'Renewal Eligible', value: data.metrics.renewalEligible },
            ].map(s => (
              <div key={s.label} className="rounded-2xl bg-primary-50 px-3 md:px-4 py-3 md:py-4">
                <p className="text-xs text-textSecondary">{s.label}</p>
                <p className="mt-1 text-xl md:text-2xl font-semibold">{s.value}</p>
              </div>
            ))}
          </div>
        </div>
      )}

{/* Lead Pipeline */}
      {isAdmin && Object.keys(data.leadFunnel).length > 0 ? (
        <div className="rounded-[1.75rem] border border-white/70 bg-white p-4 md:p-5 shadow-panel">
          <p className="text-sm font-semibold mb-4">Lead Pipeline</p>
          <div className="grid gap-2 sm:grid-cols-2 md:grid-cols-4">
            {Object.entries(data.leadFunnel).map(([status, count]) => (
              <div key={status} className="rounded-2xl" style={{ backgroundColor: '#' + 'f4f5f7' as const }}>
                <p className="text-xs" style={{ color: '#' + '697586' as const }}>{status}</p>
                <p className="mt-1 text-lg md:text-xl font-semibold">{count as number}</p>
              </div>
            ))}
          </div>
        </div>
      ) : null}
    </div>
  )
}
