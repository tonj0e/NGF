# Copy to mcp/.env (gitignored) and fill in. Never commit real values.
# Base URL of the CRM. Local dev server by default; use the live site only when you mean to change live data.
NGF_API_URL=http://localhost:3000
# A dedicated Admin account for Claude (not your own login). Admins skip QR login.
NGF_MCP_USERNAME=
NGF_MCP_PASSWORD=
# Set to 1 to switch every write off (read-only mode).
NGF_MCP_READONLY=0
